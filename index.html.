<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#070b14">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Траун">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Траун: наставник</title>
<style>
:root{--bg:#070b14;--panel:#0f1626;--line:#22314f;--ink:#dfe8f7;--dim:#8497b8;--blue:#4aa3ff;--red:#ff3b30;--ok:#47d38a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#070b14;--panel:#0f1626;--ink:#dfe8f7}}
:root[data-theme="dark"]{--bg:#070b14;--panel:#0f1626;--ink:#dfe8f7}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 Georgia,"Times New Roman",serif}
main{max-width:520px;margin:0 auto;padding:16px 16px 40px}
h1{font-size:21px;margin:0;font-weight:600}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
#rank{font-size:14px;color:var(--blue)}
.bar{height:6px;background:var(--line);border-radius:3px;margin:8px 0 4px;overflow:hidden}
.bar i{display:block;height:100%;width:50%;background:var(--blue);transition:width .5s,background .5s}
.cap{font-size:12px;color:var(--dim);margin:0 0 14px}
#log{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:12px;min-height:240px;display:flex;flex-direction:column;gap:10px}
.b{border-left:3px solid var(--blue);padding:2px 0 2px 12px;font-size:17px}
.b.bad{border-left-color:var(--red)}.b.good{border-left-color:var(--ok)}
.b.me{border-left:0;border-right:3px solid var(--dim);padding:2px 12px 2px 0;text-align:right;color:var(--dim);font-size:15px}
#opts{display:grid;gap:8px;margin-top:10px;min-height:52px}
#opts button{background:transparent;color:var(--ink);border:1px solid var(--blue);border-radius:6px;padding:13px;font:inherit;text-align:left;cursor:pointer;min-height:48px}
#opts button:active{background:var(--line)}
button:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
.stats{display:flex;gap:16px;font-size:14px;color:var(--dim);margin:12px 0 0}
.stats b{color:var(--ink)}
h2{font-size:17px;margin:20px 0 8px;font-weight:600}
.ex{display:flex;width:100%;justify-content:space-between;align-items:center;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:13px;margin-bottom:8px;font:inherit;text-align:left;cursor:pointer;min-height:52px}
.ex small{color:var(--dim);font-size:14px}
.ex.on{border-color:var(--ok);color:var(--dim)}
.ex.on::after{content:"✓";color:var(--ok)}
.fr{display:grid;gap:6px}.frr{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:10px 12px;font-size:15px}.frr.me{border-color:var(--blue)}.frr small{color:var(--dim);font-size:13px}.frr i{font-style:normal;color:var(--ok)}
.set input,.set textarea{width:100%;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:10px;font:inherit;font-size:16px;margin:4px 0 10px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}.two button{background:transparent;color:var(--ink);border:1px solid var(--blue);border-radius:6px;padding:12px;font:inherit;cursor:pointer;min-height:46px}
.ob{width:100%;background:transparent;color:var(--ink);border:1px solid var(--blue);border-radius:6px;padding:12px;font:inherit;cursor:pointer;min-height:46px;margin:4px 0}
.rm{background:none;border:0;color:var(--dim);text-decoration:underline;font:inherit;font-size:12px;cursor:pointer;padding:4px}
.shake{animation:s .4s}
@keyframes s{20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}
@media (prefers-reduced-motion:reduce){.shake{animation:none}}
.reset{margin-top:18px;background:none;border:0;color:var(--dim);font:inherit;font-size:13px;text-decoration:underline;cursor:pointer;padding:8px}
.tip{font-size:13px;color:var(--dim);margin-top:14px}
.say{display:flex;gap:8px;margin-top:10px}.say input{flex:1;min-width:0;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:12px;font:inherit;font-size:16px}.say button{background:var(--blue);color:#06101f;border:0;border-radius:6px;padding:0 16px;font:inherit;cursor:pointer;min-height:48px}
.push{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:13px}.push b{font-size:28px;color:var(--blue)}.push .bar{margin:8px 0}
.pbtns{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.pbtns button{background:transparent;color:var(--ink);border:1px solid var(--blue);border-radius:6px;padding:12px 0;font:inherit;cursor:pointer;min-height:48px}.pbtns button:active{background:var(--line)}
</style>
</head>
<body>
<main id="app">
<div class="row"><h1>Гранд-адмирал Траун</h1><span id="rank"></span></div>
<div class="bar"><i id="fill"></i></div>
<p class="cap">Его уважение к тебе. Падает от пропусков и лифтов, растёт от дела.</p>
<p class="cap" id="xp"></p>
<div id="log" aria-live="polite"></div>
<div id="opts"></div>
<div class="say"><input id="txt" type="text" placeholder="Напиши Трауну…" autocomplete="off"><button id="send">Сказать</button></div>
<div class="stats"><span>Серия: <b id="sStreak">0</b></span><span>Лестниц: <b id="sStairs">0</b></span><span>Лифтов: <b id="sLift">0</b></span><span>Пропусков: <b id="sSkip">0</b></span></div>
<h2>План на сегодня</h2>
<div id="plan"></div>
<h2>Друзья</h2>
<div id="friends" class="fr"></div>
<div class="set">
<button id="shcode" class="ob">Отправить другу мой код</button>
<textarea id="codebox" rows="3" placeholder="Сюда вставь сообщение с кодом от друга"></textarea>
<button id="okcode" class="ob">Добавить друга по коду</button>
<span class="cap" id="codemsg"></span>
</div>
<h2>Мои настройки</h2>
<div class="set">
<label class="cap" for="nick">Твоё имя для друзей</label>
<input id="nick" type="text" maxlength="20" autocomplete="off" placeholder="Например, Аня">
<label class="cap" for="cplan">Мой план: по одному упражнению в строке, формат «название|подробности»</label>
<textarea id="cplan" rows="7"></textarea>
<div class="two"><button id="saveplan">Сохранить мой план</button><button id="resetplan">Стандартный план</button></div>
<button id="histbtn" class="reset">Вся история разговора</button>
</div>
<p class="tip">Чтобы поставить на телефон: в Safari нажми «Поделиться» и «На экран Домой», в Chrome открой меню и выбери «Добавить на главный экран».</p>
<button class="reset" id="reset">Сбросить прогресс</button>
</main>
<script>
var PLANS=[
["Отжимания алмазные|3 по 10","Негативные отжимания|3 по 5, вниз 5 сек","Приседания с паузой|4 по 12, пауза 2 сек внизу","Выпады назад|3 по 10 на ногу","Планка|3 по 45 сек","Отжимания от трубы|5 подходов по 20, пауза 1 сек внизу"],
["Берпи|3 по 10","Прыжки «звёздочка»|3 по 40","Бег на месте с высокими коленями|3 по 45 сек","Альпинист|3 по 30","Приседания с прыжком|3 по 12","Негативные отжимания|3 по 5, вниз 5 сек","Отжимания от трубы|5 подходов по 20, пауза 1 сек внизу"],
["Тяга гантелей в наклоне|4 по 12","Румынская тяга с гантелями|4 по 12","Жим гантелей над головой|3 по 10","Отжимания узким хватом|3 по 10","Негативные отжимания|3 по 5, вниз 5 сек","Боковая планка|3 по 30 сек на сторону","Отжимания от трубы|5 подходов по 20, пауза 1 сек внизу"]];
var L={
hello:["Наконец-то. Я ждал. Посмотрим, что ты покажешь сегодня.","Новый день, новая возможность не подвести саму себя.","Ты пришла. Это уже лучше, чем вчера. Посмотрим, хватит ли тебя на весь план.","Я изучил твои привычки. Твой главный противник — диван, а не я."],
late:["День почти кончился, а я вижу пустой план. Ты рассчитывала на завтра?","Сегодня ещё есть время. Потом его не будет. Понимаешь?","Вечер, а тренировки нет. Я заметил, как ты обходил её весь день.","Время уходит, а план стоит нетронутым. Ты умнее, чем эта отговорка."],
lost:["Ты исчезла, и серия рассыпалась. Дисциплина не прощает пропусков. Начинай снова.","Серия обнулена. Я помню, сколько ты накопила, и помню, как ты это потеряла.","Серия прервана. Ты решила, что один день ничего не стоит. Это была ошибка. Начнём заново.","Ты пропала, и серия обнулилась. Я не злюсь. Я разочарован, а это хуже."],
skip:["Ага. Значит, сегодня ты решила побыть обычной. Я не для этого тебя тренирую.","Пропуск. Я не удивлен, я разочарован, и это не одно и то же.","Ты же понимаешь, что именно в такие дни решается, кто ты есть?","Тренировка не просит разрешения у настроения. Она просто делается.","Слабая ученица ищет повод. Сильная находит время. Кто ты сегодня?","Как быстро ты сдаёшься. А ведь начинала с таким напором.","Я не ослышался? Ты хочешь пропустить?","Пропуск. Ты знала, что я это замечу.","Вот как. Значит, дисциплина кончилась на первом же трудном дне?","Ты думаешь, цель выполнит себя сама? Нет. Не выполнит.","Я учил тебя иначе. Или ты не слушала?","Пропустить? Ты сама выбрала эту цель. Предавать собственный выбор — самая дорогая слабость.","Любое оправдание звучит убедительно только для того, кто его придумал. Для меня это отступление."],
lift:["Лифт. Знакомая кнопка, знакомая слабость.","Ты ехала, пока твои ноги просили работы. Они промолчали, но я их слышал.","Каждый этаж на лифте — ступенька, которую ты не взяла.","Я не запрещаю тебе лифт. Я спрашиваю: ты уверена, что это был твой лучший выбор?","Умно. Удобно. И совсем бесполезно для цели, которую ты поставила.","Лифт? Серьёзно? Я ожидал большего.","Ступени были рядом, а ты выбрала кнопку. Это о многом говорит.","Я наблюдал. Кабина закрылась, а вместе с ней и твой прогресс на сегодня.","Лифт. Ты выбрала путь наименьшего сопротивления, а я учил тебя иначе.","Ты заплатила за лёгкость силой. Плохая сделка."],
stairs:["Ступени, а не кнопка. Верно. Я заметил.","Лестница без принуждения. Так растёт воля.","Лестница. Правильный выбор. Мелочи и делают армию.","Хорошо. Сила складывается из решений, которых никто не видит."],
step:["Принято. Следующее.","Верно. Темп важнее порыва.","Хорошо. Не останавливайся."],
done:["План выполнен. Именно так выглядит дисциплина. Завтра жду тебя снова.","Результат достойный. Я отмечаю это, и бывает такое нечасто."]
};
var KEY="thrawn_v2",S,busy=false,tm=null,lastAct=Date.now(),nagged=false;
function $(i){return document.getElementById(i)}
function today(d){d=d||new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
function yest(){var d=new Date();d.setDate(d.getDate()-1);return today(d)}
function fresh(){return {res:50,streak:0,stairs:0,lifts:0,skips:0,last:"",checks:{},push:{},goal:150,xp:0,floor:0}}
function load(){try{var r=localStorage.getItem(KEY);S=r?JSON.parse(r):fresh()}catch(e){S=fresh()}if(!S||typeof S!=="object")S=fresh();if(S.xp===undefined){S.xp=(S.res>=40?80:0)+(S.streak||0)*12;S.floor=RANKS[rk(S.xp)][0]}if(S.pi===undefined)S.pi=Math.floor(Date.now()/86400000)%3}
function save(){S.ts=Date.now();try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}pushSoon()}
function pick(k){var b=rp("L"+k,L[k]);if((k==="done"||k==="step"||k==="stairs")&&Math.random()<.5)b+=" "+rp("pr"+rk(S.xp||0),rkt().pr);return b}
function res(d){S.res=Math.max(0,Math.min(100,S.res+d));save();render()}
function rankName(){return RANKS[rk(S.xp||0)][1]+(S.res<20?" · в немилости":"")}
var EXI=-1,PEN=0;
var EXRE=/день рожд|праздник|свадьб|юбилей|в гостях|гости|холодн|мороз|дожд|снег|гололёд|заболе|болею|температур|простуд|насторок|кашел|тошнит|месячн|критическ\S* дн|поездк|в пути|уезж|командиров|перелёт|экзамен|дедлайн|не выспал|бессонн|ребёнок|переезд|ремонт|на работе/;
var OP=["Хм.","Любопытно.","Так.","Понятно.","Я так и думал.","Ты серьёзно?","Тише. Я слушаю.","Вот как."],CL=["Я записал.","Не повторяй.","Мы это исправим.","Подумай над этим.","Я буду помнить.","Не заставляй меня повторять."];
function sc(k){var b=pick(k),T=rkt(),r=rk(S.xp||0),o=Math.random()<.6?rp("op"+r,T.op)+" ":"",c=Math.random()<.5?" "+rp("cl"+r,T.cl):"";return o+b+c}
var MIN=["15 приседаний","8 отжиманий от пола","30 секунд планки","20 подъёмов на носки","10 жимов гантелей над головой","10 выпадов на каждую ногу"];
function pen2(n,intro){if(DB&&DB.on){DB.min++;say("Замена зачтётся в итоге: "+n+".","",menu);return}say(intro+n+". Пока я смотрю.","",function(){opts([{t:"Выполняю",f:function(){doing(n)}},{t:"Не буду",f:function(){refuse(n)}}])})}
function mini(){if(DB&&DB.on){DB.min++;say("Принято. Минимум спрошу в конце.","",menu);return}pen2(MIN[Math.floor(Math.random()*MIN.length)],"Облегчённый минимум: ")}
function okx(){if(PEN){res(4);xp(3);PEN=0}}
function askEx(i){EXI=i;say(rp("exq",["Назови причину своими словами. Я оценю, насколько она убедительна.","Говори. Только настоящую причину, а не удобную.","Слушаю. Объясни, что произошло."]),"",function(){Q="excuse";try{$("txt").focus()}catch(e){}opts([{t:"Назад",f:menu}])})}
function judge(v){var pl=plan(),c=S.checks[today()]||[],outd=false,i,cat;
 if(EXI>=0&&/труб/.test(pl[EXI]||""))outd=true;else for(i=0;i<pl.length;i++)if(!c[i]&&/труб/.test(pl[i]))outd=true;
 EXI=-1;
 if(/день рожд|праздник|свадьб|юбилей/.test(v))cat="bday";
 else if(/в гостях|гости|друзья|родствен/.test(v))cat="guests";
 else if(/холодн|мороз|дожд|снег|гололёд|ветер|ливень|погод/.test(v))cat="weather";
 else if(/заболе|болею|температур|простуд|насторок|кашел|тошнит|грипп|самочувств/.test(v))cat="sick";
 else if(/месячн|критическ\S* дн|цикл/.test(v))cat="cycle";
 else if(/поездк|в пути|уезж|командиров|перелёт|отпуск|дорог/.test(v))cat="trip";
 else if(/работ|учёб|экзамен|дедлайн|сесси|смен|задержал/.test(v))cat="work";
 else if(/ребёнок|дети|переезд|ремонт|уборк|помогал|семь/.test(v))cat="home";
 else if(/выспал|бессонн|мало спал|не спал/.test(v))cat="sleep";
 else if(/забыл/.test(v))cat="forgot";
 else if(/лень|не хотел|не хочет|настроени|желания/.test(v))cat="lazy";
 else if(/времени|некогда|занят/.test(v))cat="time";
 else if(/устал/.test(v))cat="tired";
 else cat="other";
 if(cat==="bday"){okx();say(["День рождения. Это достойная причина, и я её принимаю.","Сегодня ты свободна. Но завтра я жду от тебя вдвое больше собранности."],"good",menu)}
 else if(cat==="guests"){okx();say(["Гости — понятно. Хозяйка не сбегает от гостей.","Но десять минут у тебя найдутся. Минимум, и потом возвращайся к ним."],"",mini)}
 else if(cat==="weather"){if(outd){okx();say(["Холод и дождь — это причина не выходить. Но не причина не работать.","Тренировка переезжает домой."],"",function(){pen2("4 подхода по 15 отжиманий от устойчивого стола, руки на краю, тело ровное","Замена на дому: ")})}else{say("Погода не мешает заниматься дома. Отмазка слабая.","bad",function(){penalty()})}}
 else if(cat==="sick"){okx();say(["Болезнь — причина. Отдыхай, я не требую тренироваться через болезнь.","Если температура или слабость сильные, лучше показаться врачу. Возвращайся, когда будешь здорова."],"good",menu)}
 else if(cat==="cycle"){okx();say(["Понимаю. Сегодня только лёгкая активность и только по самочувствию.","Не насилуй себя. Завтра возвращаемся к плану."],"good",menu)}
 else if(cat==="trip"){okx();say(["Дорога — реальная причина. Я это учитываю.","Тогда минимум, где бы ты ни была."],"",mini)}
 else if(cat==="work"){okx();say(["Работа — реальная причина. Но двадцать минут находятся даже в загруженный день.","Облегчённый минимум, и можешь вернуться к делам."],"",mini)}
 else if(cat==="home"){okx();say(["Семья и дела дома — это важно. Я не стану спорить.","Но минимум ты сделаешь."],"",mini)}
 else if(cat==="sleep"){okx();say(["Недосып вредит восстановлению. Сегодня без полного плана.","Но минимум, чтобы тело помнило."],"",mini)}
 else if(cat==="forgot"){say(["Забыла. Ты забываешь о том, что для тебя неважно.","Исправим это взысканием."],"bad",function(){penalty()})}
 else if(cat==="lazy"){say(sc("skip"),"bad",function(){penalty()})}
 else if(cat==="time"){say("«Нет времени» — это не причина, а выбор. Я таких выборов не принимаю.","bad",function(){penalty()})}
 else if(cat==="tired"){why("tired")}
 else{say(["Необычная причина. Я не уверен, что она убедительна.","Это правда?"],"",function(){opts([{t:"Да, честно",f:function(){okx();say("Принято. Я проверю по твоим результатам.","",mini)}},{t:"Не совсем",f:function(){say("Хотя бы честно. Взыскание.","bad",function(){penalty()})}}])})}
 return true}
